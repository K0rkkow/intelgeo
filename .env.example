# ===================== GEOOSINT — 100% GRATUIT =====================
# Carte (aucune clé) : OpenStreetMap + Carto Dark via Leaflet
# Street View : Mapillary (Meta) - GRATUIT sans CB, token en 2min
#   1) Crée un compte sur https://www.mapillary.com
#   2) https://www.mapillary.com/dashboard/developers -> Generate Token
#   3) Colle le token ci-dessous. Si vide, le jeu reste jouable en mode OSM Cover.

# Client
VITE_API_URL=http://localhost:3001
VITE_MAPILLARY_TOKEN=
# Optionnel : Tile provider OSM (par défaut OpenStreetMap gratuit, pas de clé)
# VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Mapillary token côté serveur pour vérif future (optionnel, même valeur que client)
MAPILLARY_TOKEN=

# Legacy Google (plus nécessaire - laissé pour compat)
# VITE_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=
